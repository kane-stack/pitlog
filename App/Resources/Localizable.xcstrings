    "Add a vehicle to keep track of inspections, service and costs." : {
      "comment" : "Empty state description on the Vehicles tab",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Fahrzeug hinzu, um Begutachtungen, Service und Kosten im Blick zu behalten."
          }
        }
      }
    },
    "Add an odometer reading to plan this reminder. Two readings at least two weeks apart are needed for an estimate." : {
      "comment" : "Reminder status: a service by odometer needs odometer readings (two, two weeks apart) to estimate a date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage einen Kilometerstand ein, um diese Erinnerung zu planen. Für eine Schätzung braucht es zwei Stände im Abstand von mindestens zwei Wochen."
          }
        }
      }
    },
    "Add entry" : {
      "comment" : "History: button to add a new entry",
