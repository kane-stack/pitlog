    },
    "A transfer permit does not contain the vehicle data. Scan the registration certificate (part I) instead." : {
      "comment" : "Registration scan: a transfer permit was scanned",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
