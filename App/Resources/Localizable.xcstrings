      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenn­zei­chen oder FIN auf dem Beleg passen nicht zu diesem Fahrzeug. Prüfe, ob der Beleg dazugehört."
          }
        }
      }
    },
    "The new vignette is available from today." : {
      "comment" : "Notification body: the new annual vignette can be bought from today (1 December in Austria)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Vignette ist ab heute erhältlich."
          }
        }
      }
    },
    "The prices could not be loaded. Check your connection and try again." : {
      "comment" : "Paywall: the products could not be loaded",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Preise konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        }
      }
    },
    "The punched month on the inspection sticker is not on the certificate. Enter it from the sticker itself." : {
      "comment" : "Registration review: hint that the sticker punch must be entered by hand",
      "localizations" : {
        "de" : {
          "stringUnit" : {
