    "You can look these provisions up in the Austrian Legal Information System (RIS)." : {
      "comment" : "Legal screen: hint where to find the sources, no link on purpose",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Bestimmungen findest du im Rechtsinformationssystem des Bundes (RIS)."
          }
        }
      }
    },
    "You get a reminder on %@ when the new vignette is available, and before the old one expires. A vignette bought online may only be valid from the 18th day after purchase." : {
      "comment" : "Vignette reminder editor footer. Argument: day and month the new vignette is available",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst am %@ eine Erinnerung, wenn die neue Vignette erhältlich ist, und vor dem Ablauf der alten. Eine online gekaufte Vignette gilt womöglich erst ab dem 18. Tag nach dem Kauf."
          }
        }
      }
    },
    "Your purchase is waiting for approval. Pro starts as soon as it goes through." : {
      "comment" : "Paywall: the purchase is pending, for example Ask to Buy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Freigabe. Pro startet, sobald er durch ist."
          }
        }
      }
    },
    "Your vignette is valid until %@. A vignette bought online may only be valid from the 18th day after purchase." : {
      "comment" : "Notification body: the vignette expires soon, with the hint about the 18 day delay for online purchases. Argument: the date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Vignette ist bis %@ gültig. Eine online gekaufte Vignette gilt womöglich erst ab dem 18. Tag nach dem Kauf."
          }
        }
      }
    },
