    "A PDF of the history of a vehicle, for example for selling it." : {
      "comment" : "Pitlog Pro benefit: PDF service record",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein PDF mit der Historie eines Fahrzeugs, zum Beispiel für den Verkauf."
          }
        }
      }
    },
    "A VIN has 17 characters." : {
      "comment" : "Vehicle form: hint when the VIN length is not 17",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine FIN hat 17 Zeichen."
          }
        }
      }
    },
    "A transfer permit does not contain the vehicle data. Scan the registration certificate (part I) instead." : {
      "comment" : "Registration scan: a transfer permit was scanned",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Über­stel­lungs­fahrt­schein enthält die Fahr­zeug­da­ten nicht. Scanne statt­des­sen den Zu­las­sungs­schein (Teil I)."
          }
        }
      }
    },
    "About" : {
      "comment" : "Settings row for the about screen; Navigation title of the about screen",
      "localizations" : {
