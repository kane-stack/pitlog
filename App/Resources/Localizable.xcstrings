        }
      }
    },
    "The free plan lets you edit one vehicle. This vehicle stays here and you can read everything. Pitlog Pro unlocks editing for all your vehicles." : {
      "comment" : "Notice on a vehicle that is over the free limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
