{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %lld more" : {
      "comment" : "History row: the first work items, then how many more there are. First argument: a list of work items, second: the number of further items",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %lld weitere"
          }
        }
      }
    },
    "%@ every %@" : {
      "comment" : "Paywall: price of a subscription with a longer period. First argument: the price, second: the length such as 3 months",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ alle %2$@"
          }
        }
      }
    },
    "%@ free, then %@ per year. Cancel any time." : {
      "comment" : "Paywall: free trial of the subscription. First argument: the length such as 14 days, second: the price",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis, danach %2$@ pro Jahr. Jederzeit kündbar."
