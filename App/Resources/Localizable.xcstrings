    },
    "Add a vehicle to keep track of inspections, service and costs." : {
      "comment" : "Empty state description on the Vehicles tab",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Fahrzeug hinzu, um Be­gut­ach­tun­gen, Service und Kosten im Blick zu behalten."
          }
        }
      }
    },
    "Add an odometer reading to plan this reminder. Two readings at least two weeks apart are needed for an estimate." : {
      "comment" : "Reminder status: a service by odometer needs odometer readings (two, two weeks apart) to estimate a date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage einen Ki­lo­me­ter­stand ein, um diese Er­in­ne­rung zu planen. Für eine Schätzung braucht es zwei Stände im Abstand von mindestens zwei Wochen."
          }
        }
      }
    },
    "Add entry" : {
