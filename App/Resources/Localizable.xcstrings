          }
        }
      }
    },
    "The license plate on the receipt matches this vehicle." : {
      "comment" : "Receipt review: the license plate of the receipt belongs to the selected vehicle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kenn­zei­chen auf dem Beleg passt zu diesem Fahrzeug."
          }
        }
      }
    },
    "The license plate or VIN on the receipt does not match this vehicle. Check that the receipt belongs to it." : {
