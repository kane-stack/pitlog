    "Check the date on your sticker." : {
      "comment" : "Legal hint at the end of every inspection notification: the date on the inspection sticker is authoritative",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datum auf der Plakette prüfen."
          }
        }
      }
    },
    "Check the month against the punch on your inspection sticker before you save." : {
      "comment" : "Sticker update from a receipt: reminds the user that the sticker is authoritative",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche den Monat mit der Lochung auf deinem Pickerl, bevor du sicherst."
          }
        }
      }
    },
    "Check the new sticker and adjust if needed." : {
      "comment" : "Record inspection: ask the user to verify the proposal against the sticker",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die neue Plakette und passe die Eingabe bei Bedarf an."
          }
        }
      }
    },
    "Check the scan" : {
      "comment" : "Navigation title of the registration review",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan prüfen"
          }
        }
      }
    },
    "Check what was read from your certificate. Only values that are switched on are copied into the form. Nothing is saved until you tap Save." : {
      "comment" : "Registration review: introduction",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, was vom Zulassungsschein gelesen wurde. Nur eingeschaltete Werte werden ins Formular übernommen. Gespeichert wird erst, wenn du auf Sichern tippst."
          }
        }
      }
    },
    "Check what was read from your receipt. Only values that are switched on are copied into the entry. Nothing is saved until you tap Save." : {
      "comment" : "Receipt review: introduction when the review fills the entry form",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, was aus deinem Beleg gelesen wurde. Nur Werte, die eingeschaltet sind, werden in den Eintrag übernommen. Gespeichert wird erst mit „Sichern“."
          }
        }
      }
    },
    "Check what was read from your receipt. Only values that are switched on go into the new entry." : {
      "comment" : "Receipt review: introduction when the review creates a new entry",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, was aus deinem Beleg gelesen wurde. Nur Werte, die eingeschaltet sind, kommen in den neuen Eintrag."
          }
        }
      }
    },
